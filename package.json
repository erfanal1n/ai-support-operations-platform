{
  "name": "ai-support-operations-platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "uv run python -m backend.app.run --reload",
    "dev:web": "pnpm --filter @support/console dev",
    "start": "uv run python -m backend.app.run",
    "auth:config": "uv run python -m backend.app.generate_credentials",
    "mcp": "uv run python -m backend.app.mcp_server",
    "db:migrate": "uv run python -m backend.app.migrate",
    "eval:retrieval": "uv run python -m backend.app.evaluate_policy_search",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @support/console build",
    "typecheck": "pnpm --filter @support/console exec tsc -p tsconfig.json --noEmit"
  }
}
